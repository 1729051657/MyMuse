# Copy to .env. Keep that file private and back it up with the volumes.
SITE_HOST=muse.example.com
SESSION_DOMAIN=agents.example.com
ACME_EMAIL=

# Generate each separately: openssl rand -hex 32
CLOUD_SECRET=
CLOUD_ADMIN_TOKEN=
WEB_SLUG_SALT=

# Your existing model provider's OpenAI-compatible endpoint and model menu.
# Replace the model id and prices with those of your provider before starting.
# Prices are CNY per million tokens; the allowance is metered using these values.
UPSTREAM_BASE=https://models.example.com/v1
UPSTREAM_KEY=
CLOUD_MODELS='[{"id":"your-model-id","name":"Your model","upstream":"your-model-id","input_modalities":["text","image"],"for":["chat","gui"],"recommended":true,"recommended_for":["chat","gui"],"price_in":3,"price_out":12}]'
CHAT_DEFAULTS='{}'

# E-mail registration. Use port 465 for SSL or 587 for STARTTLS.
CODE_SENDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MyMuse <no-reply@example.com>

# 1 allows public registration. 0 permits only ALLOWED_IDENTIFIERS.
SIGNUP_OPEN=1
ALLOWED_IDENTIFIERS=
# Lifetime allowance per account, in CNY. This is not a recurring paid plan.
ALLOWANCE_CNY=10
PER_MINUTE_REQUESTS=30

# These are resource limits, not measured capacity. Each assistant stays running.
# Keep the two counts equal unless you intentionally want accounts to wait for capacity.
WEB_MAX_ACCOUNTS=4
WEB_MAX_RUNNING=4
WEB_CONTAINER_MEMORY=1g
WEB_CONTAINER_CPUS=1
MYMUSE_RUNTIME_IMAGE=mymuse-runtime:local
# Change if this subnet overlaps an existing Docker network or your LAN.
MYMUSE_EDGE_SUBNET=172.30.80.0/24

# Local acceptance only, on http://muse.localhost:9080. No public certificates.
# SITE_HOST=muse.localhost
# SESSION_DOMAIN=agents.localhost
# PUBLIC_SCHEME=http
# PUBLIC_PORT=:9080
# HTTP_BIND=127.0.0.1
# HTTP_PORT=9080
# HTTPS_BIND=127.0.0.1
# HTTPS_PORT=9443
# CADDY_CONFIG=Caddyfile.local
# CODE_SENDER=log
